# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY MyApp.csproj ./
RUN dotnet restore

COPY . ./
RUN dotnet publish -c release -o /out

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app

COPY --from=build /out ./

EXPOSE 8080
ENTRYPOINT ["dotnet", "MyApp.dll"]
